{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "title",
          "status",
          "reason"
        ],
        "properties": {
          "record_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "doi": {
            "type": [
              "string",
              "null"
            ]
          },
          "publisher_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "priority": {
            "enum": [
              "HIGH",
              "NORMAL"
            ]
          },
          "status": {
            "enum": [
              "NEEDS_MANUAL_REVIEW"
            ]
          },
          "reason": {
            "type": "string"
          },
          "recommended_action": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "generated_at",
    "items"
  ]
}
